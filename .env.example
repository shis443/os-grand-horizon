# database connection 

DATABASE_HOST = 'ENTER YOUR DATABSE HOST NAME'
DATABASE_USER = 'ENTER YOUR DATABSE USER NAME'
DATABASE_PASS = 'ENTER YOUR DATABSE PASSWORD'
DATABASE_NAME = 'ENTER YOUR DATABSE NAME'

# Set it to 'production' or 'development'
ENVIRONMENT = 'development'

# PATH to osgrandhorizon/public folder (for example, http://localhost/osgrandhorizon/public)
PROJECT_URL = 'http://localhost/osgrandhorizon/public'

# PATH to osgrandhorizon/api folder (for example, http://localhost/osgrandhorizon/api)
API_URL = 'http://localhost/osgrandhorizon/api'


# AWS info

AWS_ACCESS_KEY = 'ENTER YOUR AWS ACCESS KEY HERE'
AWS_SECRET_KEY = 'ENTER YOUR AWS SECRET KEY HERE'
AWS_S3_BUCKET = 'ENTER YOUR AWS S3 BUCKET NAME'


# smtp email info

SMTP_USER = 'ENTER YOUR SMTP USER HERE'
SMTP_PASS = 'ENTER YOUR SMTP PASS HERE'
# SMTP_HOST: Optional, Default: smtp.sendgrid.com, smtp.gmail.com for Gmail SMTP
SMTP_HOST = 'ENTER YOUR SMTP HOST HERE'
# SMTP_PORT: Optional, Default: 587
SMTP_PORT = 'ENTER YOUR SMTP PORT HERE'
# SMTP_CRYPTO: Optional, Default: Empty, can be 'ssl' or 'tls', tls for Gmail SMTP, Leave empty for Sendgrid
SMTP_CRYPTO = 'ENTER YOUR SMTP PORT HERE'

# Capthcha info

RECAPTCHA_SITE_KEY = 'ENTER YOUR RECAPTCHA SITE KEY HERE'
RECAPTCHA_SECRET_KEY = 'ENTER YOUR RECAPTCHA SECRET KEY HERE'


# Cron auth (shared secret for cron.php and panther_channel/cron_* actions)
CRON_AUTH_SECRET = 'ENTER A RANDOM SECRET HERE'

# Channex (panther_channel extension) — see PLAN_CHANNEL.md
CHANNEX_BASE_URL = 'https://staging.channex.io/api/v1'
CHANNEX_API_KEY = 'ENTER YOUR CHANNEX API KEY HERE'
CHANNEX_PROPERTY_ID = 'ENTER YOUR CHANNEX PROPERTY ID HERE'
CHANNEX_WEBHOOK_SECRET = 'ENTER A RANDOM SECRET HERE'
